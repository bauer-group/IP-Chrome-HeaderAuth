# =============================================================================
# BAUER GROUP Header Authenticator — CI credentials
# =============================================================================
# Copy to .env and fill in what you want to sync. NEVER commit .env.
#
# -- Sync convention (read by scripts/secrets/sync.mjs) -----------------------
# `npm run secrets:sync` pushes keys to GitHub Actions, routing each one by a
# marker comment in THIS file (.env.example):
#
#     # @secret        → Repository Secret    (${{ secrets.X }})
#     # @var           → Repository Variable  (${{ vars.X }})
#     # @file <path>   → Repository Secret, value read from <path> on disk
#     # @local         → never synced; CI residue actively cleaned up
#     (no marker)      → @secret (safety fallback)
#
# The marker applies to the next KEY=… line below it.
#
# What goes where:
#   * @secret → credentials. Masked in logs, never readable back.
#   * @var    → non-sensitive switches. Readable in `if:` conditions, which
#               `secrets.X` cannot do — that is why PUBLISH_WEB_STORE is a var.
#   * @file   → values that already live in a file and must not be duplicated
#               into .env, where the two copies would drift. Read from disk at
#               push time and NEVER deleted: a missing file means "not on this
#               machine", not "retire the CI secret".
#
# -- Not managed here ---------------------------------------------------------
# Org-level secrets arrive automatically via `secrets: inherit` and are NOT
# repository entries — do not re-create them here or you will own a second
# rotation schedule:
#   GITGUARDIAN_API_KEY · GITLEAKS_LICENSE · CODECOV_TOKEN
#   SONARQUBE_TOKEN · SONARQUBE_HOST_URL · TEAMS_WEBHOOK_URL
# GITHUB_TOKEN is provided by Actions per run and needs no setup at all.
# See docs/secrets.md.
# =============================================================================


# -- Extension signing (required for releases) --------------------------------
# The private half of the signing key pair. It alone determines the extension
# ID; the matching public half is pinned as EXTENSION_KEY in wxt.config.ts, and
# sync.mjs refuses to push a key that derives a different ID.
#
# Read from .keys/key.pem — leave this line empty, it is a declaration only.
# @file .keys/key.pem
EXTENSION_PRIVATE_KEY=


# -- Chrome Web Store (optional, currently disabled) --------------------------
# The publish-web-store job in .github/workflows/release.yml stays skipped until
# PUBLISH_WEB_STORE is "true". Fill these in only once a listing exists — v2
# pins a new extension ID, so it cannot update a pre-existing listing in place.
#
# Obtain via the Chrome Web Store API OAuth flow:
# https://developer.chrome.com/docs/webstore/using-api

# @secret
CWS_CLIENT_ID=

# @secret
CWS_CLIENT_SECRET=

# @secret
CWS_REFRESH_TOKEN=

# @secret
CWS_EXTENSION_ID=

# Gate for the publish-web-store job. A variable, not a secret, because
# `if: vars.PUBLISH_WEB_STORE == 'true'` cannot read a secret.
# @var
PUBLISH_WEB_STORE=false
